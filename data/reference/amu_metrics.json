{
  "schema_version": "1.0.0",
  "records": [
    {
      "id": "AMU-ACTIVE-MASS",
      "name": "Active-ingredient mass used",
      "tier": "CORE",
      "formula": "SUM(administered_product_amount * active_ingredient_concentration * unit_conversion_factor)",
      "required_inputs": [
        "actual_amount",
        "actual_amount_unit",
        "ingredient_concentration_value",
        "ingredient_concentration_numerator_unit",
        "ingredient_concentration_denominator_unit",
        "unit_conversion_factor",
        "conversion_provenance"
      ],
      "unit": "MG_ACTIVE_INGREDIENT",
      "source_ids": ["SRC-WOAH-TAHC-6.9"],
      "limitations": "Compare by ingredient/class; mass alone is sensitive to potency."
    },
    {
      "id": "AMU-MG-PER-ANIMAL",
      "name": "Active-ingredient mass per animal at risk",
      "tier": "CORE_WHEN_POPULATION_AVAILABLE",
      "formula": "total_active_mg / mean_animals_at_risk",
      "required_inputs": ["active_mg", "animal_at_risk_roster", "period_start", "period_end"],
      "unit": "MG_PER_ANIMAL_PERIOD",
      "source_ids": ["SRC-WOAH-TAHC-6.9", "SRC-FAO-AMU-FARM-2023"],
      "limitations": "Denominator definition and herd movements must be consistent."
    },
    {
      "id": "AMU-MG-PER-KG",
      "name": "Active-ingredient mass per kg liveweight at risk",
      "tier": "CONDITIONAL",
      "formula": "total_active_mg / total_liveweight_kg_at_risk",
      "required_inputs": [
        "active_mg",
        "animal_weights_kg",
        "weight_measurement_dates",
        "population_at_risk"
      ],
      "unit": "MG_PER_KG_LIVEWEIGHT_PERIOD",
      "source_ids": ["SRC-WOAH-TAHC-6.9", "SRC-EMA-AMU-2023"],
      "limitations": "Do not estimate unvalidated standard cattle/buffalo weights."
    },
    {
      "id": "AMU-TREATED-PROPORTION",
      "name": "Animals treated proportion",
      "tier": "CORE",
      "formula": "distinct_treated_animals / animals_at_risk * 100",
      "required_inputs": ["animal_id", "administration_date", "population_at_risk"],
      "unit": "PERCENT_PER_PERIOD",
      "source_ids": ["SRC-WOAH-TAHC-6.9", "SRC-FAO-AMU-FARM-2023"],
      "limitations": "Measures reach, not amount or appropriateness."
    },
    {
      "id": "AMU-TREATMENT-INCIDENCE",
      "name": "Treatment incidence",
      "tier": "CORE_WHEN_ANIMAL_TIME_AVAILABLE",
      "formula": "animal_antimicrobial_treatment_days / animal_days_at_risk * 1000",
      "required_inputs": [
        "animal_id",
        "course_coverage_days",
        "herd_entry_date",
        "herd_exit_date",
        "period"
      ],
      "unit": "TREATMENT_DAYS_PER_1000_ANIMAL_DAYS",
      "source_ids": ["SRC-FAO-AMU-FARM-2023", "SRC-WOAH-TAHC-6.9"],
      "limitations": "Document how overlaps and long-acting products create coverage days."
    },
    {
      "id": "AMU-TREATMENT-DAYS",
      "name": "Antimicrobial treatment-days",
      "tier": "CORE",
      "formula": "COUNT_DISTINCT(animal_id, antimicrobial_coverage_calendar_day)",
      "required_inputs": ["animal_id", "administration_time", "course_coverage_or_regimen"],
      "unit": "ANIMAL_TREATMENT_DAY",
      "source_ids": ["SRC-FAO-AMU-FARM-2023"],
      "limitations": "Does not capture dose magnitude; long-acting coverage needs explicit method."
    },
    {
      "id": "AMU-COURSES",
      "name": "Completed antimicrobial courses",
      "tier": "CORE",
      "formula": "COUNT_DISTINCT(completed_course_id)",
      "required_inputs": ["course_id", "completion_status", "ingredient_id"],
      "unit": "COURSE",
      "source_ids": ["SRC-WOAH-TAHC-6.10"],
      "limitations": "Course grouping and completion data must be reliable."
    },
    {
      "id": "AMU-MEAN-DURATION",
      "name": "Mean antimicrobial course duration",
      "tier": "CORE",
      "formula": "SUM(course_duration_days) / completed_course_count",
      "required_inputs": [
        "course_id",
        "course_start",
        "last_administration_or_end",
        "completion_status"
      ],
      "unit": "DAY_PER_COURSE",
      "source_ids": ["SRC-WOAH-TAHC-6.9"],
      "limitations": "Calendar-duration convention must be documented."
    },
    {
      "id": "AMU-DDDVET",
      "name": "Number of DDDvet per biomass or dairy-cow denominator",
      "tier": "ADVANCED_CONDITIONAL",
      "formula": "active_mg_used / assigned_DDDvet_mg_per_kg, then divide by matched biomass; intramammary uses assigned units and dairy-cow denominator",
      "required_inputs": [
        "active_mg_or_intramammary_units",
        "EMA_DDDvet_mapping",
        "species",
        "route_form",
        "long_acting_flag",
        "biomass_or_dairy_cow_denominator",
        "methodology_version"
      ],
      "unit": "DDDvet_PER_DENOMINATOR_PERIOD",
      "source_ids": ["SRC-EMA-DDDVET-2015", "SRC-EMA-AMU-2023"],
      "limitations": "EU technical surveillance unit, not a prescribed dose or Indian threshold."
    },
    {
      "id": "AMU-DCDVET",
      "name": "Number of DCDvet per biomass or dairy-cow denominator",
      "tier": "ADVANCED_CONDITIONAL",
      "formula": "active_mg_used / assigned_DCDvet_mg_per_kg, then divide by matched biomass; intramammary uses assigned course units and dairy-cow denominator",
      "required_inputs": [
        "active_mg_or_intramammary_units",
        "EMA_DCDvet_mapping",
        "species",
        "route_form",
        "long_acting_flag",
        "biomass_or_dairy_cow_denominator",
        "methodology_version"
      ],
      "unit": "DCDvet_PER_DENOMINATOR_PERIOD",
      "source_ids": ["SRC-EMA-DDDVET-2015", "SRC-EMA-AMU-2023"],
      "limitations": "EU technical surveillance unit; mappings are incomplete for some products/forms."
    }
  ]
}
