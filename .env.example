# ============================================================
# DFMS Livestock Platform — Environment Configuration
# MERN Stack with MySQL (Node.js + Express + React + MySQL)
# ============================================================

NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# --- MySQL Local Configuration ---
# Format: mysql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE_NAME>
# For example, if your root password is 'manager':
DATABASE_URL=mysql://root:manager@127.0.0.1:3306/dfms_livestock
MYSQL_DATABASE=dfms_livestock
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=manager

# --- Authentication ---
JWT_SECRET=local-jwt-secret-key-dfms-livestock-platform-2026
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7

# --- AWS S3 (Optional for local development) ---
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_PRESIGNED_URL_EXPIRY_SECONDS=300
MAX_PRIVATE_FILE_SIZE_BYTES=10485760

# --- Frontend API URL ---
VITE_API_BASE_URL=http://localhost:3000/api/v1

# --- Optional AI Advisor Service ---
ML_SERVICE_URL=http://localhost:8000
LLM_PROVIDER=OPENAI_COMPATIBLE
LLM_API_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openrouter/free