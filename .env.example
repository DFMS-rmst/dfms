# ==========================================
# Digital Farm Management - Environment Template (.env.example)
# Copy this file to .env and configure local values.
# NEVER commit real credentials or production keys.
# ==========================================

NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
APP_BASE_URL=http://localhost:5173

# Database Connection
# When running on host Windows with Docker MySQL (host port 3307):
DATABASE_URL=mysql://farm_app:farm_app_local_password@127.0.0.1:3307/digital_farm
# When running inside Docker Compose network:
# DATABASE_URL=mysql://farm_app:farm_app_local_password@mysql:3306/digital_farm

# Authentication Secrets (Must be at least 32 characters)
JWT_SECRET=local-demo-jwt-secret-minimum-32-chars-key
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7

# AWS S3 Storage (Optional for local demo - leave blank to use in-memory PDF generation)
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_PRESIGNED_URL_EXPIRY_SECONDS=300
MAX_PRIVATE_FILE_SIZE_BYTES=10485760

# ML Decision Support Service
# When running backend on host Windows connecting to Docker ML port:
ML_SERVICE_URL=http://localhost:8000
# When running backend inside Docker Compose network:
# ML_SERVICE_URL=http://ml:8000

# LLM Smart Advisor (Optional - leave key blank if not using external AI)
LLM_PROVIDER=OPENAI_COMPATIBLE
LLM_API_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
LLM_API_KEY=

# Blockchain Proof Layer (Optional - leave blank for local demo)
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_NETWORK=hardhat-local
