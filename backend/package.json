{
  "name": "@dfms/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "vitest run --fileParallelism=false",
    "test:unit": "vitest run --fileParallelism=false --exclude '**/*.integration.test.js'",
    "test:integration": "vitest run --fileParallelism=false '**/*.integration.test.js'",
    "prisma:generate": "prisma generate",
    "db:check": "node scripts/check-database.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.864.0",
    "@aws-sdk/s3-request-presigner": "^3.864.0",
    "@prisma/client": "^6.12.0",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "ethers": "^6.15.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.20.1",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "qrcode": "^1.5.4",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "prisma": "^6.12.0",
    "supertest": "^7.1.4",
    "vitest": "^3.2.4"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
