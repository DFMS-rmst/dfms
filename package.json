{
  "name": "dfms-livestock-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "build": "npm run build --workspace frontend",
    "build:all": "npm run build --workspace frontend",
    "test": "npm run test --workspace backend && npm run test --workspace frontend",
    "test:unit": "npm run test:unit --workspace backend && npm run test --workspace frontend",
    "test:all": "npm run test --workspace backend && npm run test --workspace frontend",
    "lint": "eslint . && prettier --check README.md package.json eslint.config.js .prettierrc.json \"backend/**/*.{js,json}\" \"frontend/**/*.{js,jsx,json,html,css}\" \"docs/architecture/**/*.md\"",
    "format": "prettier --write .",
    "db:check": "npm run db:check --workspace backend",
    "ml:start": "node scripts/start-ml.js"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "eslint": "^9.34.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "prettier": "^3.6.2"
  }
}
